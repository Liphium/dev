---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import favicon from "../assets/favicon.png";

const { language, title, summary, software } = Astro.props;
---

<!doctype html>
<html lang={language}>
	<head>
		<ClientRouter fallback="swap" />
		<meta name="color-scheme" content="dark" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href={favicon.src} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} - liphium.dev</title>

		<!-- Discord embed and stuff -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="liphium.dev" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={summary} />
		<meta content="#00cdf9" data-react-helmet="true" name="theme-color" />

		<!-- Pagefind stuff -->
		{software && software !== "" && (
			<link href={`/pagefind/${software}/pagefind-component-ui.css`} rel="stylesheet" />
			<script src={`/pagefind/${software}/pagefind-component-ui.js`} type="module"></script>
		)}
	</head>
	<body class="bg-bg-800">
		<slot />
	</body>
</html>

<script>
	import type { TransitionBeforeSwapEvent } from "astro:transitions/client";

	const sidebarPositions = new Map<string, number>();
	const sidebars = () => document.querySelectorAll<HTMLElement>("[data-sidebar-scroll]");
	const restoreSidebarScroll = () => {
		sidebars().forEach((sidebar) => {
			sidebar.scrollTop = sidebarPositions.get(sidebar.dataset.sidebarScroll!) ?? 0;
		});
	};

	document.addEventListener("astro:before-swap", (event) => {
		(event as TransitionBeforeSwapEvent).viewTransition.skipTransition();
		sidebars().forEach((sidebar) => {
			sidebarPositions.set(sidebar.dataset.sidebarScroll!, sidebar.scrollTop);
		});
	});
	document.addEventListener("astro:after-swap", restoreSidebarScroll);
	document.addEventListener("astro:page-load", restoreSidebarScroll);
</script>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
