		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.2.4",
		"rehype-pretty-code": "^0.14.5",
		"rehype-raw": "^7.0.0",
		"svelte": "^5.56.10",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/markdown-remark": "^7.2.4",
		"mdast": "^2.3.2",
		"pagefind": "^1.5.2",
		"remark": "^15.0.1",
		"typescript": "^5.9.3",
		"unified": "^11.0.5"
	}
